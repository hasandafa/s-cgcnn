# =====================================
# s-CGCNN .gitignore
# =====================================

# ===== SENSITIVE DATA =====
# NEVER commit API keys!
config/mp_api_key.txt
config/*.key
config/*.token
.env
.env.local
ACTION_PLAN.md
clean_data.bat
quick_test.bat
setu_windows.bat
setup_windows.ps1
fix_unicode.py
patch_all_bugs.py

# ===== PYTHON =====
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# PyCharm
.idea/
*.iml

# VS Code
.vscode/
*.code-workspace

# Spyder
.spyderproject
.spyproject

# ===== DATA FILES =====
# Large data files (optional: keep structure but ignore content)
data/raw/*.json
data/structures/cif/*.cif
data/structures/metadata/*.json
data/graphs/*.pt
data/graphs/*.pkl
data/processed/*

# Except example/template files
!data/raw/.gitkeep
!data/structures/cif/.gitkeep
!data/structures/metadata/.gitkeep
!data/graphs/.gitkeep

# ===== MODEL FILES =====
models/*.pt
models/*.pth
models/*.ckpt
models/*.h5
results/models/*

# Keep directory structure
!models/.gitkeep
!results/models/.gitkeep

# ===== LOGS =====
logs/*.log
logs/*.txt
*.log

# Keep logs directory
!logs/.gitkeep

# ===== RESULTS =====
results/figures/*.png
results/figures/*.pdf
results/figures/*.svg
results/predictions/*
results/recommendations/*

# Keep results structure
!results/figures/.gitkeep
!results/predictions/.gitkeep
!results/recommendations/.gitkeep

# ===== TEMPORARY FILES =====
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===== VISUALIZATION =====
# Large visualization files
*.html
!docs/*.html

# ===== DATABASE =====
*.db
*.sqlite
*.sqlite3

# ===== COMPRESSED FILES =====
*.zip
*.tar.gz
*.rar
*.7z

# ===== WANDB =====
wandb/

# ===== TENSORBOARD =====
runs/
events.out.tfevents.*

# ===== SYSTEM FILES =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ===== DOCUMENTATION BUILD =====
docs/_build/
docs/_static/
docs/_templates/
site/

# ===== MISC =====
.scratch/
scratch/
temp/
tmp/

# Ignore old version branches if accidentally created
version-*
v0.*-branch